# Copy to kiro-gw.env (or $KIRO_GW_ENV_FILE), then:
#   chmod 600 kiro-gw.env
# Never commit this file.

# Kiro API key (ksk_...). API-key auth must be enabled by your Kiro admin.
KIRO_API_KEY=ksk_replace_me

# Client-facing gateway key. Generate with: openssl rand -hex 32
KIRO_GATEWAY_API_KEY=replace_with_a_long_random_value

# Agent mode: deny Kiro's own shell/file tools on the gateway host.
KIRO_GATEWAY_PERMISSIONS=deny
# Harness mode: allow client tools relayed through the MCP tool bridge.
KIRO_GATEWAY_HARNESS_PERMISSIONS=allow-always
# Claude Code's WebSearch reaches Kiro as a tool titled remote/web_search (kind "other").
KIRO_GATEWAY_PERMISSION_RULES=allow:title=remote/web_search

# Directories a request may select with X-Kiro-Workspace.
KIRO_GATEWAY_ALLOWED_WORKSPACES=/workspace,/workspace/*

KIRO_GATEWAY_MAX_CONCURRENCY=4
KIRO_GATEWAY_SESSION_MODE=affinity
# Keep an idle Kiro session for an hour (default 600 s): a client that pauses longer would
# get a new kiro-cli and a replay of its whole conversation. About 360 MB per idle session.
KIRO_GATEWAY_SESSION_IDLE_TTL=3600
# Load the model catalogue at startup and refresh it once a day (default 600 s); a refresh
# holds up the request that triggers it for several seconds.
KIRO_GATEWAY_MODELS_CACHE_TTL=86400

# Logs: text (default) or json lines for a log shipper. The container log is capped by
# docker-compose.yml (KIRO_GW_LOG_MAX_SIZE x KIRO_GW_LOG_MAX_FILE, default 10m x 5).
#KIRO_GATEWAY_LOG_FORMAT=json
